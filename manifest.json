{
  "manifest_version": 3,
  "name": "BlendConv",
  "version": "1.1.0",
  "description": "Capture and merge your AI conversations across ChatGPT and Claude.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "utils/storage.js",
        "utils/extractor.js",
        "content-scripts/panel.js",
        "content-scripts/chatgpt.js"
      ],
      "css": [
        "content-scripts/floating-button.css",
        "content-scripts/toast.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "utils/storage.js",
        "utils/extractor.js",
        "content-scripts/panel.js",
        "content-scripts/claude.js"
      ],
      "css": [
        "content-scripts/floating-button.css",
        "content-scripts/toast.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
